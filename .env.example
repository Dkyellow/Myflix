APP_NAME=MyFlix
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database Configuration (MySQL by default, falls back to sqlite if MySQL connection fails)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=myflix
DB_USERNAME=root
DB_PASSWORD=

# LiveKit WebRTC Configuration
LIVEKIT_URL=wss://livekit.example.com
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
