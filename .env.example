# Copy to .env and edit.
#
# For a hosted copy (cPanel etc.) keep APP_ENV=production and APP_DEBUG=false:
# with anything else the error pages print exception messages and stack traces.

APP_NAME=MyFlix
APP_ENV=production
APP_DEBUG=false
APP_URL=https://yourdomain.com

# Database Configuration
# SQLite needs no setup (storage/ must be writable) and is what this app uses
# by default. MySQL needs a database + user created in cPanel.
DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=myflix
DB_USERNAME=myflix_user
DB_PASSWORD=

# LiveKit WebRTC Configuration
LIVEKIT_URL=wss://livekit.example.com
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
